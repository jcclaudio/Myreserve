# ==============================================================================
# FIXTUR PROPOSAL & HOTEL QUOTE ENGINE — .gitignore
# ==============================================================================

# 📦 Dependencies & Package Managers
node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz
package-lock.json.bak

# 🚀 Next.js & Build Outputs
.next/
/out/
/build
/dist
.turbo/
.vercel/
tsconfig.tsbuildinfo
next-env.d.ts.bak

# 🧪 Testing & Coverage
coverage/
.nyc_output/
*.lcov
.vitest/

# 🔐 Environment Variables & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.crt

# 🗄️ Local SQLite Databases & WAL/Journals
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
prisma/*.db
prisma/*.db-journal
prisma/*.db-wal
prisma/*.db-shm
prisma/dev.db
prisma/prod.db
prisma/test.db

# 📤 User Uploads, Media & Deploy Packages
public/uploads/*
!public/uploads/.gitkeep
uploads/
*.ofx.tmp
*.zip
*.tar.gz
*.rar
*.7z
myreserve-deploy.zip

# 📝 Debug Logs & Process PIDs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log
*.pid
*.seed
*.pid.lock

# 💻 Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Tt]humbs.db
desktop.ini

# 🛠️ IDE, Agent & Editor Settings
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
.cursor/
.claude/
.gemini/
.windsurf/
.zed/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 🗂️ Temporary & Scratch Folders
scratch/
tmp/
temp/
*.tmp
