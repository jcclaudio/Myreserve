# ==============================================================================
# FIXTUR PROPOSAL & HOTEL QUOTE ENGINE — .gitignore
# ==============================================================================

# 📦 Dependencies
node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz

# 🚀 Next.js & Build Outputs
.next/
/out/
/build
/dist
tsconfig.tsbuildinfo
next-env.d.ts.bak

# 🧪 Testing & Coverage
coverage/
.nyc_output/
*.lcov
.vitest/

# 🔐 Environment Variables & Secrets (Always commit .env.example)
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# 🗄️ Local SQLite Databases & WAL/Journals
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
prisma/*.db
prisma/*.db-journal
prisma/*.db-wal
prisma/*.db-shm
prisma/dev.db
prisma/prod.db
prisma/test.db

# 📤 User Uploads & Media
public/uploads/*
!public/uploads/.gitkeep
uploads/
*.ofx.tmp

# 📝 Debug Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# 💻 Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Tt]humbs.db
desktop.ini

# 🛠️ IDE & Editor Settings
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 🗂️ Temporary & Scratch Folders
scratch/
tmp/
temp/
*.tmp
