# ==============================================================================
# VARIÁVEIS DE AMBIENTE — FIXTUR / MYRESERVE
# ==============================================================================

# BANCO DE DADOS (MySQL):
# Desenvolvimento local (Docker / MySQL local):
DATABASE_URL="mysql://myreserve:myreserve_dev_pass@localhost:3306/myreserve_dev"

# Produção:
# DATABASE_URL="mysql://usuario:senha@host-do-banco:3306/myreserve"

# AUTENTICAÇÃO E SEGURANÇA:
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace-with-a-strong-initial-password"
# Mantenha true em HTTPS. Use false apenas temporariamente para teste direto por HTTP.
COOKIE_SECURE=true

# CONFIGURAÇÃO GERAL:
NODE_ENV="production"
PORT=3000
NEXT_PUBLIC_APP_NAME="MyReserve"

# API DE CÂMBIO (AwesomeAPI):
EXCHANGE_API_URL="https://economia.awesomeapi.com.br/json/last/USD-BRL,EUR-BRL"
