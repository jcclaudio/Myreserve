# ==============================================================================
# VARIÁVEIS DE AMBIENTE — FIXTUR / MYRESERVE
# ==============================================================================

# BANCO DE DADOS:
# Desenvolvimento local: o Prisma resolve este caminho a partir de prisma/schema.prisma,
# resultando em prisma/dev.db.
DATABASE_URL="file:./dev.db"

# Produção: use um caminho absoluto dentro do volume persistente. Exemplo Integrator:
# DATABASE_URL="file:/app/data/myreserve.db"

# AUTENTICAÇÃO E SEGURANÇA:
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace-with-a-strong-initial-password"

# CONFIGURAÇÃO GERAL:
NODE_ENV="production"
PORT=3000
NEXT_PUBLIC_APP_NAME="MyReserve"

# API DE CÂMBIO (AwesomeAPI):
EXCHANGE_API_URL="https://economia.awesomeapi.com.br/json/last/USD-BRL,EUR-BRL"
